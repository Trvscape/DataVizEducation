E_ring <- read.csv("E_ring.csv")
view(F)
G <- read_excel("Level of Education Attainment Tab 3.xlsx", sheet = "Table 21")
View(G)
G |>
select(1, 22:30)
G |>
select(1, 22:30) |>
slice(5:18)
G |>
select(1, 22:30) |>
slice(5:17)
G |>
select(1, 22:30) |>
slice(5:17) |>
slice(-c(2,3))
G |>
select(1, 22:30) |>
slice(5:17) |>
slice(-c(2,3), 13)
G |>
select(1, 22:30) |>
slice(5:17) |>
slice(-c(2, 3, 13))
G_clean <-  G |>
select(1, 22:30) |>
slice(5:17) |>
slice(-c(2, 3, 13))
names(G_clean) <- c(
"Highest Educational Attainment",
"NSW", "Vic", "Qld", "SA", "WA",
"Tas", "NT", "ACT", "Aust"
)
View(G_clean)
G_clean <-  G |>
select(1, 22:30) |>
slice(5:17) |>
slice(-c(1, 2, 3, 13))
names(G_clean) <- c(
"Highest Educational Attainment",
"NSW", "Vic", "Qld", "SA", "WA",
"Tas", "NT", "ACT", "Aust"
)
G_clean <- G_clean |>
mutate(
across(where(is.numeric), ~ round(.x, 1))
)
View(G_clean)
print(G_clean, digits = 4)
str(G_clean)
G_clean <- G_clean |>
mutate(
across(
-`Highest Educational Attainment`,
~ round(as.numeric(.x), 1)
)
)
G_donut <- G_clean |>
pivot_longer(
cols = -`Highest Educational Attainment`,
names_to = "State",
values_to = "Count"
) |>
group_by(State) |>
mutate(
Percentage = Count / sum(Count) * 100
) |>
ungroup()
View(G_donut)
G_donut_total <- G_donut |>
filter(State == "Aust")
View(G_donut_total)
G_donut_total <- G_donut_total |>
mutate(
`Highest Educational Attainment` = if_else(
`Highest Educational Attainment` %in% c(
"Year 11",
"Year 10",
"Year 9 or below(b)(c)"
),
"Year 11 or below",
`Highest Educational Attainment`
)
) |>
group_by(`Highest Educational Attainment`) |>
summarise(
Count = sum(Count),
Percentage = sum(Percentage),
.groups = "drop"
)
ggplot(G_donut_total, aes(x = 2, y = Percentage, fill = `Highest Educational Attainment`)) +
geom_col(width = 1, colour = "white") +
coord_polar(theta = "y") +
xlim(0.5, 2.5) +
geom_text(
aes(label = paste0(round(Percentage, 1), "%")),
position = position_stack(vjust = 0.5),
size = 3
) +
labs(fill = "Education level") +
theme_void() +
theme(
legend.position = "right",
legend.title = element_text(colour = "#243B53"),
legend.text = element_text(size = 10, colour = "#243B53")
)
ggplot(G_donut_total, aes(x = 2, y = Percentage,
fill = reorder(`Highest Educational Attainment`, Percentage))) +
geom_col(width = 1, colour = "white") +
coord_polar(theta = "y") +
xlim(0.5, 2.5) +
geom_text(
aes(label = paste0(round(Percentage, 1), "%")),
position = position_stack(vjust = 0.5),
size = 3
) +
labs(fill = "Education level") +
theme_void() +
theme(
legend.position = "right",
legend.title = element_text(colour = "#243B53"),
legend.text = element_text(size = 10, colour = "#243B53")
)
write.csv(G_donut_total, "G_donut_total.csv", row.names = FALSE)
G_spider <- G_clean |>
filter(
`Highest Educational Attainment` %in% c(
"Postgraduate Degree",
"Graduate Diploma/Graduate Certificate",
"Bachelor Degree"
)
) |>
select(-`Highest Educational Attainment`) |>
summarise(across(everything(), sum)) |>
pivot_longer(
cols = everything(),
names_to = "State",
values_to = "Count"
) |>
filter(State != "Aust")
View(G_spider)
G_spider <- G_spider |>
mutate(
State = if_else(
State %in% c("Tas", "NT", "ACT"),
"Other states/territories",
State
)
) |>
group_by(State) |>
summarise(Count = sum(Count), .groups = "drop")
G_spider_plot <- G_spider |>
pivot_wider(
names_from = State,
values_from = Count
)
G_spider_plot <- rbind(
max = rep(max(G_spider$Count), nrow(G_spider_plot)),
min = rep(0, nrow(G_spider_plot)),
G_spider_plot
)

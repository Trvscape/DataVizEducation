```{r library}
library(tidyverse)
library(readxl)
library(sf)
library(rnaturalearth)
library(rnaturalearthdata)
library(pak)
library(rnaturalearthhires)
```

```{r Import CSV}
A <-  read.csv("A.csv")
```



```{r Map Preparation}
aus <- rnaturalearth::ne_states(
  country = "Australia",
  returnclass = "sf"
)
aus <- aus |>
  filter(name %in% c(
    "New South Wales",
    "Victoria",
    "Queensland",
    "Western Australia",
    "South Australia",
    "Tasmania",
    "Northern Territory",
    "Australian Capital Territory"
  ))
A_map <- A |>
  mutate(State = trimws(gsub("\u00A0", " ", State))) |>
  filter(State != "Multi-State")

aus_map <- aus |>
  left_join(A_map, by = c("name" = "State"))
```

```{r Rank Bar Chart Tab 1 Creation}
p_rankbar <-  ggplot(A, aes(x = Average, y = reorder(State, Average))) +
  geom_col(fill = "#2C7A7B") +
  labs(
    x = "Average Enrolments (2020–2024)",
    y = NULL
  ) +
  theme_minimal()
```

```{r Australian Map Tab 1 Creation}
p_map <-  ggplot(aus_map) +
  geom_sf(aes(fill = Average), colour = "white") +
  scale_fill_gradient(
    low = "#B8D8D8",
    high = "#243B53",
    name = "Average Enrolments"
  ) +
  theme_void()
```


